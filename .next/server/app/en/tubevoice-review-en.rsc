1a:["$","p","9",{"className":"text-zinc-300 leading-relaxed mb-4","children":["The pipeline is straightforward: speech recognition extracts the original transcript, AI translates it while preserving timing, and text-to-speech generates the dubbed audio. The original music and background sounds are preserved using AI audio separation."]}]
1b:["$","h2","11",{"className":"text-2xl font-bold text-white mt-12 mb-4","children":"Three quality tiers"}]
1c:["$","p","13",{"className":"text-zinc-300 leading-relaxed mb-4","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Basic"}]," uses Google Chirp3-HD voices. Clean, intelligible, but obviously synthetic. At 1 credit per minute, it works for casual viewing."]}]
1d:["$","p","15",{"className":"text-zinc-300 leading-relaxed mb-4","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Standard"}]," uses ElevenLabs Flash with preset voices. Noticeably more natural intonation and rhythm. 3 credits per minute."]}]
1e:["$","p","17",{"className":"text-zinc-300 leading-relaxed mb-4","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Premium"}]," uses ElevenLabs Dubbing API with automatic voice cloning. The dubbed version sounds like the original speaker but in your language. 6 credits per minute."]}]
1f:["$","h2","19",{"className":"text-2xl font-bold text-white mt-12 mb-4","children":"Pricing"}]
20:["$","p","21",{"className":"text-zinc-300 leading-relaxed mb-4","children":["20 free credits to start. Packs: $20 for 200 credits, $50 for 550 credits, $120 for 1800 credits. No subscription required."]}]
21:["$","h2","23",{"className":"text-2xl font-bold text-white mt-12 mb-4","children":"What impressed us"}]
22:["$","p","25",{"className":"text-zinc-300 leading-relaxed mb-4","children":["Premium voice cloning is genuinely good. In a test with an English tech review, the Czech dubbed version preserved the speaker's tone and pacing. Background music stayed clean throughout."]}]
23:["$","h2","27",{"className":"text-2xl font-bold text-white mt-12 mb-4","children":"What could improve"}]
24:["$","p","29",{"className":"text-zinc-300 leading-relaxed mb-4","children":["Multi-speaker videos with overlapping dialogue still trip up the system. Auto-detection occasionally misidentifies regional accents. The processing queue can stack up during peak hours."]}]
25:["$","h2","31",{"className":"text-2xl font-bold text-white mt-12 mb-4","children":"Verdict"}]
26:["$","p","33",{"className":"text-zinc-300 leading-relaxed mb-4","children":["For the price point, TubeVoice delivers solid value. The three-tier system lets you match quality to budget. If you regularly watch foreign YouTube content and subtitles frustrate you, this is worth trying."]}]
