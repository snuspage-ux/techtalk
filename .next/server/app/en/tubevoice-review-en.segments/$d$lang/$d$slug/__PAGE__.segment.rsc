0:{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"max-w-3xl mx-auto px-6 py-16","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"TubeVoice review — AI dubbing for YouTube videos\",\"description\":\"We tested TubeVoice, an AI tool that translates and dubs YouTube videos into 50+ languages. Three quality tiers, credit-based pricing, and surprisingly natural results.\",\"datePublished\":\"2026-03-19T08:00:00Z\",\"dateModified\":\"2026-03-19T08:00:00Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"TechTalk\",\"url\":\"https://techtalk.tech\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TechTalk\",\"url\":\"https://techtalk.tech\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://techtalk.tech/favicon.svg\"}},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://techtalk.tech/en/tubevoice-review-en\"},\"image\":{\"@type\":\"ImageObject\",\"url\":\"https://images.unsplash.com/photo-1611162617474-5b21e879e113?w=800&q=80\",\"width\":800,\"height\":450},\"inLanguage\":\"en\",\"keywords\":\"AI dubbing, YouTube translation, TubeVoice, voice cloning\",\"articleSection\":\"ai\",\"wordCount\":295}"}}],["$","$L2",null,{"href":"/","className":"text-sm text-zinc-500 hover:text-violet-400 transition-colors mb-8 inline-block","children":"← Back to TechTalk"}],["$","div",null,{"className":"flex items-center gap-3 text-xs text-zinc-500 mb-6","children":[["$","$L2",null,{"href":"/category/ai","className":"px-2 py-0.5 rounded-full border text-violet-400 bg-violet-500/10 border-violet-500/20","children":"ai"}],["$","span",null,{"className":"w-1 h-1 rounded-full bg-zinc-600"}],["$","time",null,{"children":"March 19, 2026"}],["$","span",null,{"className":"w-1 h-1 rounded-full bg-zinc-600"}],["$","span",null,{"children":[3," min read"]}]]}],["$","h1",null,{"className":"text-3xl md:text-4xl font-bold tracking-tight mb-8 leading-ti