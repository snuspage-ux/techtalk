5:["$","p","17",{"className":"text-zinc-300 leading-relaxed mb-4","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Premium"}]," uses ElevenLabs Dubbing API with automatic voice cloning. The dubbed version sounds like the original speaker but in your language. 6 credits per minute."]}]
