0:{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"max-w-3xl mx-auto px-6 py-16","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"TubeVoice recenze — AI dabing YouTube videí\",\"description\":\"Otestovali jsme TubeVoice, nástroj pro automatický překlad a dabing YouTube videí do 50+ jazyků. Tři úrovně kvality a překvapivě přirozené výsledky.\",\"datePublished\":\"2026-03-19T08:00:00Z\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"TechTalk\",\"url\":\"https://techtalk.tech\"},\"image\":\"https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=800&q=80\",\"inLanguage\":\"cs\"}"}}],["$","$L2",null,{"href":"/","className":"text-sm text-zinc-500 hover:text-violet-400 transition-colors mb-8 inline-block","children":"← Back to TechTalk"}],["$","div",null,{"className":"flex items-center gap-3 text-xs text-zinc-500 mb-6","children":[["$","$L2",null,{"href":"/category/ai","className":"px-2 py-0.5 rounded-full border text-violet-400 bg-violet-500/10 border-violet-500/20","children":"ai"}],["$","span",null,{"className":"w-1 h-1 rounded-full bg-zinc-600"}],["$","time",null,{"children":"March 19, 2026"}],["$","span",null,{"className":"w-1 h-1 rounded-full bg-zinc-600"}],["$","span",null,{"children":[3," min read"]}]]}],["$","h1",null,{"className":"text-3xl md:text-4xl font-bold tracking-tight mb-8 leading-tight","children":"TubeVoice recenze — AI dabing YouTube videí"}],["$","div",null,{"className":"mb-10 rounded-2xl overflow-hidden border border-white/[0.06]","children":["$","img",null,{"src":"https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=800&q=80","alt":"Video editing studio setup","className":"w-full h-64 md:h-80 object-cover"}]}],["$","div",null,{"children":[["$","h2","1",{"className":"text-2xl font-bold text-white mt-12 mb-4","children":"Co je TubeVoice?"}],["$","p","3",{"className":"text-zinc-300 leading-relaxed mb-4","children":["TubeVoice je webový nástroj, který vezme libovolné YouTube video a vytvoří jeho nadabovanou verzi v jiném jazyce. Vložíte odkaz, vyberete cílový jazyk, zvolíte kvalitu hlasu a za 2-5 minut máte hotovo."]}],["$","p","5",{"className":"text-zinc-300 leading-relaxed mb-4","children":["Nástroj byl spuštěn začátkem roku 2026 a cílí na diváky, kteří chtějí sledovat zahraniční obsah ve svém jazyce."]}],["$","h2","7",{"className":"text-2xl font-bold text-white mt-12 mb-4","children":"Jak to funguje"}],["$","p","9",{"className":"text-zinc-300 leading-relaxed mb-4","children":["Pipeline je jednoduchý: rozpoznávání řeči extrahuje originální přepis, AI přeloží text se zachováním časování a syntéza řeči vygeneruje nadabovaný zvuk. Originální hudba a zvuky na pozadí jsou zachovány pomocí AI separace zvuku."]}],["$","h2","11",{"className":"text-2xl font-bold text-white mt-12 mb-4","children":"Tři úrovně kvality"}],["$","p","13",{"className":"text-zinc-300 leading-relaxed mb-4","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Basic"}]," používá Google Chirp3-HD hlasy. Čisté, srozumitelné, ale zjevně syntetické. Za 1 kredit na minutu stačí pro běžné sledování."]}],["$","p","15",{"className":"text-zinc-300 leading-relaxed mb-4","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Standard"}]," využívá ElevenLabs Flash s přednastavenými hlasy. Výrazně přirozenější intonace a rytmus. 3 kredity za minutu."]}],["$","p","17",{"className":"text-zinc-300 leading-relaxed mb-4","children":["",["$","strong","1",{"className":"text-white font-semibold","children":"Premium"}]," používá ElevenLabs Dubbing API s automatickým klonováním hlasu. Nadabovaná verze zní jako originální mluvčí, ale ve vašem jazyce. 6 kreditů za minutu."]}],"$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc"]}],"$Ld","$Le","$Lf"]}],["$L10"],"$L11"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"9iq99AEOENUD4