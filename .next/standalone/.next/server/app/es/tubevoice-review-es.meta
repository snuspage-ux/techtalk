{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/[slug]/layout,_N_T_/[lang]/[slug]/page,_N_T_/es/tubevoice-review-es"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/$d$slug/__PAGE__",
    "/$d$lang/$d$slug",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}